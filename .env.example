# =========================
# JuYu Runtime Configuration Template
# =========================
# 用法：
# 1) 复制为 .env
# 2) 先在 dry_run=true 下验证链路
# 3) 补齐目标平台真实凭据后，再切 JUYU_ADAPTER_DRY_RUN=false

# =========================
# Core / Service
# =========================
JUYU_CONFIG=/app/configs/agents.yaml
JUYU_STORE=postgres
JUYU_SQLITE_PATH=/app/juyu.db
JUYU_PG_DSN=host=postgres port=5432 user=postgres password=postgres dbname=juyu sslmode=disable timezone=Asia/Shanghai

# 写接口鉴权；生产建议务必设置
JUYU_API_KEY=

# 可选：写接口操作员身份映射
# 格式：operator_id:token,operator2:token2
JUYU_OPERATOR_TOKENS=

# =========================
# LLM / Generation Runtime
# =========================
# 可选：stub | nvidia | openai_compat
CONTENT_GEN_PROVIDER=openai_compat
CONTENT_GEN_MODEL=qwen3-coder-plus
CONTENT_GEN_TEMPERATURE=0.4
CONTENT_GEN_MAX_TOKENS=220
CONTENT_GEN_SYSTEM_PROMPT=你擅长生成电商商品发布文案，输出准确、简洁、可直接使用。
CONTENT_GEN_PROMPT_TEMPLATE=你是电商运营文案助手。请为以下商品生成一段简洁但可直接用于发布页的中文商品文案，控制在120字内。输出纯文本，不要加标题。商品标题：{{title}}。商品描述：{{description}}。目标平台：{{platform}}。

# 可选：stub | nvidia | openai_compat
PAGE_GEN_PROVIDER=openai_compat
PAGE_GEN_MODEL=qwen3-coder-plus
PAGE_GEN_TEMPERATURE=0.3
PAGE_GEN_MAX_TOKENS=260
PAGE_GEN_SYSTEM_PROMPT=你擅长生成电商商品页面结构，输出 JSON，字段必须稳定。
PAGE_GEN_PROMPT_TEMPLATE=请基于以下商品信息生成一个 JSON 页面草图。字段必须包含 title 和 sections，sections 为字符串数组。不要输出 markdown，不要输出解释。商品标题：{{title}}。商品描述：{{description}}。目标平台：{{platform}}。

# =========================
# Provider Credentials
# =========================
# NVIDIA（如果不用可留空）
NVIDIA_URL=
NVIDIA_KEY=
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# OpenAI-compatible（当前推荐 DashScope coding）
OPENAI_COMPAT_URL=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=qwen3-coder-plus

# =========================
# Adapter Runtime Mode
# =========================
# true  = 演示/联调模式（允许无真实平台凭据）
# false = live 模式（缺真实平台凭据时发布/上下架会失败）
JUYU_ADAPTER_DRY_RUN=true

# =========================
# Alibaba Adapter
# Live 最低门槛：JUYU_ALIBABA_APP_KEY / JUYU_ALIBABA_SECRET
# =========================
JUYU_ALIBABA_APP_KEY=
JUYU_ALIBABA_SECRET=
JUYU_ALIBABA_BASE_URL=
JUYU_ALIBABA_SIGN_METHOD=md5
JUYU_ALIBABA_VERSION=2.0
JUYU_ALIBABA_REQUEST_FORMAT=json
JUYU_ALIBABA_AUTH_PLACEMENT=body
JUYU_ALIBABA_INCLUDE_APP_KEY=true
JUYU_ALIBABA_INCLUDE_VERSION=true
JUYU_ALIBABA_PUBLISH_METHOD=
JUYU_ALIBABA_UPDATE_METHOD=
JUYU_ALIBABA_ON_SHELF_METHOD=
JUYU_ALIBABA_OFF_SHELF_METHOD=
JUYU_ALIBABA_PUBLISH_PATH=
JUYU_ALIBABA_UPDATE_PATH=
JUYU_ALIBABA_ON_SHELF_PATH=
JUYU_ALIBABA_OFF_SHELF_PATH=
JUYU_ALIBABA_TIMEOUT_MS=30000
JUYU_ALIBABA_RETRY_ATTEMPTS=1
JUYU_ALIBABA_RETRY_DELAY_MS=500

# =========================
# Taobao Adapter
# Live 最低门槛：JUYU_TAOBAO_APP_KEY / JUYU_TAOBAO_SECRET
# =========================
JUYU_TAOBAO_APP_KEY=
JUYU_TAOBAO_SECRET=
JUYU_TAOBAO_BASE_URL=
JUYU_TAOBAO_SIGN_METHOD=md5
JUYU_TAOBAO_VERSION=2.0
JUYU_TAOBAO_REQUEST_FORMAT=json
JUYU_TAOBAO_AUTH_PLACEMENT=body
JUYU_TAOBAO_PUBLISH_METHOD=
JUYU_TAOBAO_UPDATE_METHOD=
JUYU_TAOBAO_ON_SHELF_METHOD=
JUYU_TAOBAO_OFF_SHELF_METHOD=
JUYU_TAOBAO_PUBLISH_PATH=
JUYU_TAOBAO_UPDATE_PATH=
JUYU_TAOBAO_ON_SHELF_PATH=
JUYU_TAOBAO_OFF_SHELF_PATH=
JUYU_TAOBAO_TIMEOUT_MS=30000
JUYU_TAOBAO_RETRY_ATTEMPTS=1
JUYU_TAOBAO_RETRY_DELAY_MS=500

# =========================
# Douyin Adapter
# Live 最低门槛：JUYU_DOUYIN_CLIENT_ID / JUYU_DOUYIN_CLIENT_SECRET
# =========================
JUYU_DOUYIN_CLIENT_ID=
JUYU_DOUYIN_CLIENT_SECRET=
JUYU_DOUYIN_BASE_URL=
