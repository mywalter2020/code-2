# app config
JUYU_CONFIG=/app/configs/agents.yaml

# store: memory | sqlite | postgres
JUYU_STORE=postgres

# sqlite
JUYU_SQLITE_PATH=/app/juyu.db

# postgres
JUYU_PG_DSN=host=postgres port=5432 user=postgres password=postgres dbname=juyu sslmode=disable timezone=Asia/Shanghai

# optional write auth
JUYU_API_KEY=

# adapter mode: true keeps demo runnable without real credentials
JUYU_ADAPTER_DRY_RUN=true

# adapter credentials
JUYU_ALIBABA_APP_KEY=
JUYU_ALIBABA_SECRET=
JUYU_TAOBAO_APP_KEY=
JUYU_TAOBAO_SECRET=
JUYU_DOUYIN_CLIENT_ID=
JUYU_DOUYIN_CLIENT_SECRET=

# optional NVIDIA LLM for content_gen
NVIDIA_URL=
NVIDIA_KEY=
NVIDIA_MODEL=meta/llama-3.1-405b-instruct
